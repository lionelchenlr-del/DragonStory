function Data.RequiredXP(level)
 return math.floor(65+level*32+level^1.2*3)
end
function Data.MonsterStats(id,level)
 local d=assert(Data.Monsters[id]);level=math.clamp(math.floor(level or d.Level),d.Level,d.MaxLevel)
 return {Level=level,HP=math.floor((70+18*level)*d.HPScale),Attack=math.floor((7+1.25*level)*d.AttackScale),
 Coins=math.floor((25+5*level)*d.CoinScale),XP=math.floor(Data.RequiredXP(level)*d.XPScale)}
end

return Data

local function distance2(x,z,p) return (x-p[1])^2+(z-p[3])^2 end
function Data.Contains(island,x,z)
 local c,s=island.Center,island.Size
 return ((x-c[1])/(s[1]*.5))^2+((z-c[3])/(s[2]*.5))^2 <= .96
end
function Data.At(x,z)
 for _,id in ipairs(Data.Order) do local i=Data.Islands[id];if Data.Contains(i,x,z) then return i end end
 return nil
end
function Data.PointRadius(number)
 return ({[1]=130,[2]=145,[3]=155,[4]=150,[5]=130,[6]=185,[7]=120,[8]=110})[number]
end
function Data.Surface(island,x,z)
 local base=island.Center[2]
 local y=base
 for _,p in ipairs(island.Points) do if distance2(x,z,p.Position)<=Data.PointRadius(p.Number)^2 then y=math.max(y,p.Position[2]) end end
 for _,route in ipairs(island.Routes) do
  for k=1,#route-1 do
   local a,b=island.Points[route[k]].Position,island.Points[route[k+1]].Position
   local dx,dz=b[1]-a[1],b[3]-a[3];local len=dx*dx+dz*dz
   local t=math.clamp(((x-a[1])*dx+(z-a[3])*dz)/len,0,1)
   local px,pz=a[1]+dx*t,a[3]+dz*t
   if (x-px)^2+(z-pz)^2<=28^2 then y=math.max(y,a[2]+(b[2]-a[2])*t+2) end
  end
 end
 return y
end
function Data.Cave(island)
 local p=island.Points[5].Position
 return {p[1],island.Center[2]-300,p[3]}
end
function Data.InCave(island,x,y,z)
 local c=Data.Cave(island)
 return math.abs(x-c[1])<60 and y>c[2]-15 and y<c[2]+65 and z<c[3]+45 and z>c[3]-275
end

return Data

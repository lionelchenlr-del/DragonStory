function Data.Percent(chance)
 local result=string.format("%.2f",chance*100):gsub("0+$",""):gsub("%.$","");return result.."%"
end
function Data.ForItem(item,order)
 local out={}
 for _,id in ipairs(order) do local p=Data.Pools[id]
  for k,v in ipairs(p.Items) do if v==item then table.insert(out,{Monster=id,Chance=p.Weights[k]/10000}) end end
 end
 return out
end
function Data.Validate(C,Settings)
 for _,id in ipairs(C.MonsterOrder) do
  local a,b=Data.Pools[id],Settings.DropTables[id];assert(a and b,"missing pool: "..id)
  local sum=b.None
  assert(a.None==b.None and #a.Items==#b.Items,"loot display mismatch")
  for k,item in ipairs(b.Items) do assert(C.Items[item] and a.Items[k]==item and a.Weights[k]==b.Weights[k],"loot item mismatch");sum+=b.Weights[k] end
  assert(sum==10000 and b.Chance==(10000-b.None)/10000,"invalid loot probability sum")
 end
 return true
end

return Data
